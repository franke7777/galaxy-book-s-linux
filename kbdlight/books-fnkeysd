#!/usr/bin/python3 -I
# Fn keys of the Galaxy Book S: Fn+F9 (keyboard backlight) is sent by the keyboard SLHD0001
# as report 5 on the vendor page 0xFF7F, which the kernel drops.
# This daemon reads hidraw and re-emits the key through a virtual keyboard (uinput) as
# KEY_KBDILLUMTOGGLE, so Sway sees XF86KbdLightOnOff.
# Report: 9 bytes, ID 5, then key codes; Fn+F9 = 0xBF, one report per press, none on release.
import fcntl, glob, os, struct, time

EV_SYN, EV_KEY, KEY_KBDILLUMTOGGLE = 0, 1, 228
KEYS = {0xBF: KEY_KBDILLUMTOGGLE}
UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_SETUP, UI_DEV_CREATE = 0x405C5503, 0x5501

def find():
    for u in glob.glob("/sys/class/hidraw/*/device/uevent"):
        if "SLHD0001" in open(u).read():
            return "/dev/" + u.split("/")[4]
    raise SystemExit("SLHD0001 not found")

ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
fcntl.ioctl(ui, UI_SET_EVBIT, EV_KEY)
for k in KEYS.values():
    fcntl.ioctl(ui, UI_SET_KEYBIT, k)
fcntl.ioctl(ui, UI_DEV_SETUP, struct.pack("<HHHH80sI", 0x06, 0x144D, 0x2E2, 1, b"Book S Fn Keys", 0))
fcntl.ioctl(ui, UI_DEV_CREATE)

def emit(code, value):
    t = time.time()
    s, us = int(t), int((t % 1) * 1e6)
    os.write(ui, struct.pack("<qqHHi", s, us, EV_KEY, code, value)
                 + struct.pack("<qqHHi", s, us, EV_SYN, 0, 0))

dev = find()
print("reading", dev, flush=True)
fd = os.open(dev, os.O_RDONLY)
while True:
    r = os.read(fd, 64)
    if not r or r[0] != 5:
        continue
    for b in r[1:]:
        if b in KEYS:
            emit(KEYS[b], 1)
            emit(KEYS[b], 0)
